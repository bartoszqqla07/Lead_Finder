// Domyślne kategorie wyszukiwania. Nowa kategoria = nowy obiekt, bez rekompilacji.
//   id          – stały identyfikator (logi, --categories)
//   query       – fraza wysyłana do Google jako "{query} {miasto}"
//   englishName – nazwa angielska (pod przyszłe prompty AI / SEO)
//   aliases     – dodatkowe nazwy akceptowane w --categories (wielkość liter i polskie znaki bez znaczenia)
//   tone        – ton szkicu wiadomości: barber, hair, beauty, nails, spa, tattoo, cosmetology
//                 (nieznany ton → neutralny szablon domyślny)
{
  "categories": [
    {
      "id": "salon-kosmetyczny",
      "query": "salon kosmetyczny",
      "englishName": "beauty salon",
      "aliases": [ "kosmetyczny", "kosmetyczka", "kosmetyka" ],
      "tone": "beauty"
    },
    {
      "id": "salon-fryzjerski",
      "query": "salon fryzjerski",
      "englishName": "hair salon",
      "aliases": [ "fryzjer", "fryzjerka", "fryzjerski" ],
      "tone": "hair"
    },
    {
      "id": "barber-shop",
      "query": "barber shop",
      "englishName": "barber shop",
      "aliases": [ "barber", "barbershop", "barberzy" ],
      "tone": "barber"
    },
    {
      "id": "salon-paznokci",
      "query": "salon paznokci",
      "englishName": "nail salon",
      "aliases": [ "paznokcie", "manicure", "stylizacja paznokci" ],
      "tone": "nails"
    },
    {
      "id": "salon-spa",
      "query": "salon spa",
      "englishName": "day spa",
      "aliases": [ "spa" ],
      "tone": "spa"
    },
    {
      "id": "studio-urody",
      "query": "studio urody",
      "englishName": "beauty studio",
      "aliases": [ "uroda" ],
      "tone": "beauty"
    },
    {
      "id": "salon-tatuazu",
      "query": "salon tatuażu",
      "englishName": "tattoo studio",
      "aliases": [ "tatuaz", "tattoo", "tatuazysta" ],
      "tone": "tattoo"
    },
    {
      "id": "gabinet-kosmetologii",
      "query": "gabinet kosmetologii",
      "englishName": "cosmetology clinic",
      "aliases": [ "kosmetologia", "kosmetolog" ],
      "tone": "cosmetology"
    }
  ]
}
